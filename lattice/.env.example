# ── LLM ──────────────────────────────────────────────
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:14b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only needed if LLM_BACKEND=claude (dev only)
ANTHROPIC_API_KEY=

# ── TELEGRAM (text-in from your phone) ─────────────────
# 1. Message @BotFather -> /newbot -> paste token below
# 2. Leave TELEGRAM_CHAT_ID empty, restart Lattice, text your bot anything
# 3. Your chat id gets logged -> paste it below, restart again
# Leave TELEGRAM_BOT_TOKEN empty to disable entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── PATHS ─────────────────────────────────────────────
# Relative to lattice/ (app runs with cwd = lattice/) — folders auto-created.
# Point these elsewhere if you want the vault outside the repo.
VAULT_PATH=vault
VAULT_FILES_PATH=vault-files
INCOMING_PATH=incoming
DB_PATH=data/lattice.db
LOGS_PATH=logs

# ── SCHEDULING ────────────────────────────────────────
WORK_START=09:00
WORK_END=22:00
CHECKIN_INTERVAL_MINUTES=120
DAILY_REVIEW_TIME=21:00
NIGHTLY_MAINTENANCE_TIME=23:00
INTENT_PLANNING_INTERVAL_MINUTES=30

# ── SERVER ────────────────────────────────────────────
# 0.0.0.0 = accessible on LAN (phone on same WiFi connects to http://[laptop-ip]:8080)
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=false

# ── FEATURES ──────────────────────────────────────────
GIT_VERSIONING_ENABLED=true
WIKI_COMPILATION_ENABLED=true
SELF_IMPROVE_ENABLED=true

# ── SECURITY ──────────────────────────────────────────
# Leave empty = no auth (local-only trust mode, fine for home network)
# Set to a strong random string to require Authorization: Bearer <key> on all API calls
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
LATTICE_API_KEY=
