# ── LLM ──────────────────────────────────────────────
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only needed if LLM_BACKEND=claude (dev only)
ANTHROPIC_API_KEY=

# ── PATHS ─────────────────────────────────────────────
# Update these to match your actual paths
VAULT_PATH=/path/to/your/vault
VAULT_FILES_PATH=/path/to/your/vault-files
INCOMING_PATH=/path/to/your/incoming
DB_PATH=/path/to/your/lattice/data/lattice.db
LOGS_PATH=/path/to/your/logs

# ── SCHEDULING ────────────────────────────────────────
WORK_START=09:00
WORK_END=22:00
CHECKIN_INTERVAL_MINUTES=120
DAILY_REVIEW_TIME=21:00
NIGHTLY_MAINTENANCE_TIME=23:00
INTENT_PLANNING_INTERVAL_MINUTES=30

# ── SERVER ────────────────────────────────────────────
# 0.0.0.0 = accessible on LAN (phone on same WiFi connects to http://[laptop-ip]:8080)
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=false

# ── FEATURES ──────────────────────────────────────────
GIT_VERSIONING_ENABLED=true
WIKI_COMPILATION_ENABLED=true
SELF_IMPROVE_ENABLED=true
VOICE_ENABLED=false

# ── SECURITY ──────────────────────────────────────────
# Leave empty = no auth (local-only trust mode, fine for home network)
# Set to a strong random string to require Authorization: Bearer <key> on all API calls
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
LATTICE_API_KEY=
